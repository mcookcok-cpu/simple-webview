<?xml version='1.0' encoding='utf-8'?>
<widget id="com.simple.webview" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Simple Browser</name>
    <description>
        Aplikasi webview Cordova ringan. Browser mini dengan fitur navigasi,
        pull-to-refresh, dan Text-to-Speech.
    </description>
    <author email="bear@local" href="https://github.com">
        BearAi
    </author>

    <content src="index.html" />

    <!-- Whitelist: hanya izinkan navigasi yang diperlukan -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Android config: modern SDK, no overscroll, no fullscreen -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="33" />
    <preference name="Orientation" value="default" />
    <preference name="Fullscreen" value="false" />
    <preference name="BackgroundColor" value="0xffffffff" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarStyle" value="default" />

    <engine name="android" spec="^12.0.0" />

    <!-- Plugin minimal: hanya yang diperlukan -->
    <plugin name="cordova-plugin-whitelist" spec="^1.3.3" />
    <plugin name="cordova-plugin-statusbar" spec="^3.0.0" />
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />

    <!-- Placeholder icon (override via res/) -->
    <platform name="android">
        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" />
    </platform>
</widget>